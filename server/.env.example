PORT=5000
# Atlas 연결 문자열 (있으면 우선 사용). 비어 있으면 로컬 DB 사용
MONGODB_ATLAS_URL=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/shopping-mall?retryWrites=true&w=majority
# 로컬: development / Heroku: production
NODE_ENV=development
JWT_SECRET=여기에_본인_시크릿_입력

# 포트원(아임포트) REST API — 결제 검증용
# 콘솔: https://admin.portone.io → 결제연동 → 내 식별코드 / API Keys
# 중요: REST API Key는 프론트 IMP.init("imp13802742") 와 같은 가맹점 계정이어야 합니다.
PORTONE_IMP_KEY=여기에_포트원_REST_API_Key
PORTONE_IMP_SECRET=여기에_포트원_REST_API_Secret
