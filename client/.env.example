# API 서버 주소 (끝 슬래시 없이)
# 로컬: http://localhost:5000
# 배포(Vercel): https://your-app.herokuapp.com
VITE_API_URL=http://localhost:5000

# Cloudinary Upload Widget (unsigned)
# Cloudinary Console → Dashboard에서 cloud name 확인
# Settings → Upload → Upload presets에서 Unsigned preset 생성 후 이름 입력
VITE_CLOUDINARY_CLOUD_NAME=your_cloud_name
VITE_CLOUDINARY_UPLOAD_PRESET=your_unsigned_preset
